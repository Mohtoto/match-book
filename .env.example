# App Configuration
#
# Env workflow: team-shared values live in `.env` (committed). Personal overrides
# go in `.env.local` (gitignored). Production uses your host's env UI (e.g. Vercel).
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=""

# Better Auth Configuration
BETTER_AUTH_URL=$NEXT_PUBLIC_APP_URL
BETTER_AUTH_SECRET=your-32-char-secret-generated-with-openssl-rand-base64-32
SUPER_ADMIN_EMAILS=admin@example.com,admin2@example.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe Configuration
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Sign-in Configuration
NEXT_PUBLIC_SIGNIN_ENABLED=false

# Dodo Payments Configuration
DODO_PAYMENTS_API_URL="https://live.dodopayments.com" # Or test.dodopayments.com for testing
DODO_PAYMENTS_API_KEY='test_yourkey'

# Cron Job Authentication
CRON_USERNAME=your_cron_username
CRON_PASSWORD=your_secure_password

# Replicate API for AI Image Generation
# Get your token from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Cookie consent (optional — when false, all categories auto-granted)
NEXT_PUBLIC_COOKIE_CONSENT_ENABLED=true

# PostHog (optional — only loads after analytics consent)
# Project token — public Project API Key (phc_…): frontend events + client feature flags
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Project secret API key (phs_…) — create in PostHog → Project settings → Project secret API keys
# https://us.posthog.com/project/137763/settings/project-secret-api-keys
POSTHOG_PROJECT_SECRET_API_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Crisp live chat (optional — only loads after support consent)
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# AWS S3 Configuration for File Storage
# Create an S3 bucket and IAM user with S3 access
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your_bucket_name_here
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Inngest Configuration for Background Jobs
# Sign up at: https://www.inngest.com/
# These keys are optional for local development (Inngest Dev Server)
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here
